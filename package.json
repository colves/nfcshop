{
  "name": "nfcshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "node scripts/prepare-media.mjs && vite build --base=./ && node scripts/generate-product-pages.mjs",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  }
}
